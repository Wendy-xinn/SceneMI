  "supervisor_source": "\nfrom pathlib import Path\nfrom datetime import datetime\nimport hashlib,json,os,subprocess,sys,traceback\nrun=Path(sys.argv[1]); root=Path(sys.argv[2])\ndef now(): return datetime.now().astimezone().isoformat()\ndef write(value):\n    p=run/'JOB.json'; t=p.with_suffix('.tmp')\n    with t.open('w') as f:\n        json.dump(value,f,ensure_ascii=False,indent=2);f.write('\\n');f.flush();os.fsync(f.fileno())\n    os.replace(t,p)\nlaunch=json.loads((run/'RESUME_LAUNCH_001.json').read_text())\njob=dict(status='starting',supervisor_pid=os.getpid(),started_at=now(),planned_stage_updates=10000,automatic_retry=False,TEST_used=False,source_commit=launch['source_commit'],commands=launch['commands'])\nwrite(job)\ntry:\n    for phase,cmd in launch['commands'].items():\n        for p,expected in launch['postprocess_source_sha256'].items():\n            if hashlib.sha256(Path(p).read_bytes()).hexdigest()!=expected: raise ValueError('Postprocessing source seal changed: '+p)\n        with (run/(phase+'.log')).open('a') as log:\n            child=subprocess.Popen(cmd,cwd=root,stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT)\n            job.update(status='running',phase=phase,child_pid=child.pid,phase_started_at=now());write(job)\n            code=child.wait()\n        job.setdefault('returncodes',{})[phase]=code;job['phase_finished_at']=now();write(job)\n        if code: raise RuntimeError(phase+' returned '+str(code))\n        if phase=='training':\n            protocol=json.loads((run/'training/protocol.json').read_text())\n            if protocol.get('status')!='completed' or protocol.get('completed_steps')!=10000: raise RuntimeError('Training did not complete all 10000 updates')\n        if phase=='CPU_verify':\n            check=json.loads((run/'CPU_MODEL_VERIFY.json').read_text())\n            if check.get('status')!='independent_CPU_model_passed' or check.get('CUDA_initialized') is not False: raise RuntimeError('Independent best model CPU check failed')\n        if phase=='CPU_temporal_report':\n            check=json.loads((run/'CPU_TEMPORAL_REVIEW.json').read_text())\n            if check.get('status')!='CPU_saved_array_audit_passed' or check.get('CUDA_initialized') is not False: raise RuntimeError('Independent saved-array CPU audit failed')\n    job.update(status='completed',finished_at=now(),completed_stage_updates=10000,independent_CPU_model_verified=True,saved_array_CPU_audit_passed=True,automatic_checkpoint_promotion=False);write(job)\nexcept BaseException as exc:\n    job.update(status='failed',finished_at=now(),error=repr(exc),traceback=traceback.format_exc());write(job);raise\n",
